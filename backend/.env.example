# ──────────────────────────────────────────────
# PortfolioOS Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# PostgreSQL connection string
# Local dev example:   postgresql://postgres:password@localhost:5432/portfolio_os
# Render/Supabase:     postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT settings
SECRET_KEY=your-secret-key-min-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins (comma-separated, required from environment, no wildcard "*")
# Local dev:           ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Production:          ALLOWED_ORIGINS=https://your-portfolio.onrender.com,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Admin seeding (used by create_admin.py) ──────────────────────────────────
# Set these before running: python create_admin.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
