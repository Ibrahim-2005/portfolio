# ──────────────────────────────────────────────
# PortfolioOS Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# PostgreSQL connection string
# Local dev example:   postgresql://postgres:password@localhost:5432/portfolio_os
# Render/Supabase:     postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT settings
SECRET_KEY=your-secret-key-min-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: CORS origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5500,https://yoursite.com
